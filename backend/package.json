{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:up": "node -r ./scripts/preload-env.cjs ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node -r ./scripts/preload-env.cjs ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "migrate:redo": "node -r ./scripts/preload-env.cjs ./node_modules/node-pg-migrate/bin/node-pg-migrate.js redo -m migrations",
    "migrate:create": "node -r ./scripts/preload-env.cjs ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create -m migrations -j ts",
    "migrate:test:up": "node -r ./scripts/preload-env.cjs ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations -d TEST_DATABASE_URL",
    "migrate:test:down": "node -r ./scripts/preload-env.cjs ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations -d TEST_DATABASE_URL",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:test:reset": "tsx -e \"import { closeDatabase, createDatabase } from './src/data/database'; import { getTestDatabaseUrl, resetTestDatabase } from './src/data/testDatabase'; (async () => { const db = await createDatabase(getTestDatabaseUrl()); try { await resetTestDatabase(db); } finally { await closeDatabase(db); } })();\"",
    "test": "npm run migrate:test:up && vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  }
}
